{
  "name": "a2mcp",
  "version": "0.10.3",
  "description": "Expose a running omp session's tools over MCP (Streamable HTTP), plus file transfer over the bridge's own /xfer route",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "oh-my-pi",
    "omp",
    "mcp",
    "agent2mcp",
    "extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-ikari/a2mcp.git"
  },
  "homepage": "https://github.com/adam-ikari/a2mcp#readme",
  "bugs": {
    "url": "https://github.com/adam-ikari/a2mcp/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/a2mcp.ts"
    ]
  },
  "files": [
    "extensions/",
    "src/"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "bun test",
    "test:smoke": "bun test/smoke.ts",
    "test:hardening": "bun test/hardening.ts",
    "test:takeover": "bun test/takeover-probe.ts",
    "test:registry": "bun test/registry-probe.ts",
    "test:tree": "bun test/tree-probe.ts",
    "test:approval": "bun test/approval-probe.ts",
    "test:install": "bun test/install-probe.ts",
    "test:mcp-call": "bun test/mcp-call-probe.ts",
    "test:bootstrap": "bun test/bootstrap-probe.ts",
    "test:obtain": "bun test/obtain-probe.ts",
    "test:scenario": "bun test/scenario.ts",
    "test:tunnel-xfer": "bun test/tunnel-xfer-probe.ts",
    "website": "cd website && bun run start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@oh-my-pi/pi-ai": "18.12.1",
    "@oh-my-pi/pi-coding-agent": "18.12.1",
    "@types/bun": "^1.4.2",
    "typescript": "5.9.3"
  }
}
