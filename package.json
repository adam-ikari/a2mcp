{
  "name": "pi-a2a-ext",
  "version": "0.2.1",
  "description": "Expose a running omp session's tools over MCP (Streamable HTTP), plus file transfer over HTTP through a quick tunnel",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "oh-my-pi",
    "omp",
    "mcp",
    "a2a",
    "extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-ikari/pi-a2a-ext.git"
  },
  "homepage": "https://github.com/adam-ikari/pi-a2a-ext#readme",
  "bugs": {
    "url": "https://github.com/adam-ikari/pi-a2a-ext/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/a2a-bridge.ts"
    ]
  },
  "files": [
    "extensions/",
    "src/"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "bun test",
    "test:smoke": "bun test/smoke.ts",
    "test:hardening": "bun test/hardening.ts",
    "test:takeover": "bun test/takeover-probe.ts",
    "test:registry": "bun test/registry-probe.ts",
    "test:tree": "bun test/tree-probe.ts",
    "test:approval": "bun test/approval-probe.ts",
    "test:install": "bun test/install-probe.ts",
    "test:bootstrap": "bun test/bootstrap-probe.ts",
    "test:obtain": "bun test/obtain-probe.ts",
    "test:scenario": "bun test/scenario.ts",
    "website": "cd website && bun run start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@oh-my-pi/pi-ai": "18.12.1",
    "@oh-my-pi/pi-coding-agent": "18.12.1",
    "@types/bun": "^1.4.2",
    "typescript": "5.9.3"
  }
}
